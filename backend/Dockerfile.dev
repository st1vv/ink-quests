# Dev image: dependencies are installed at build time; the source is
# bind-mounted by docker-compose so edits on the host reload in the container.
FROM node:24-alpine
WORKDIR /app
COPY package.json package-lock.json ./
# The npm cache survives rebuilds, so a lockfile change only downloads
# what's new.
RUN --mount=type=cache,target=/root/.npm npm ci
EXPOSE 3000
CMD ["sh", "-c", "npm run db:migrate && npm run start:dev"]
