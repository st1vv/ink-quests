PORT=3000
DATABASE_URL=postgres://inkquests:inkquests@localhost:5432/inkquests
# Frontend origin allowed by CORS (Vite dev server by default)
FRONTEND_ORIGIN=http://localhost:5173
# Optional: RPC used to verify smart-contract wallet signatures (default: public Ink RPC)
# INK_RPC_URL=
# Blockscout PRO API key (https://dev.blockscout.com) for quest verification.
# Required in production; without it the keyless public explorer is used.
# EXPLORER_API_KEY=
# Optional: Relay API used to verify bridges to Ink (default: https://api.relay.link)
# RELAY_API_URL=
